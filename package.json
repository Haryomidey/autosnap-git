{
  "name": "autosnap-git",
  "version": "1.0.0",
  "description": "Production-ready CLI for automatic Git snapshots.",
  "type": "module",
  "bin": {
    "autosnap-git": "./bin/autosnap.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild bin/autosnap.js --bundle --platform=node --outfile=dist/autosnap.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "chokidar": "^3.6.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "git",
    "snapshot",
    "cli",
    "automation"
  ],
   "repository": {
    "type": "git",
    "url": "https://github.com/Haryomidey/autosnap-git"
  },
  "license": "MIT"
}